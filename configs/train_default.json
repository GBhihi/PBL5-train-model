{
  "model_type": "lstmcnn",
  "data_csv": "data/data.csv",
  "window_size": 256,
  "step": 128,
  "cutoff": 0.1,
  "epochs": 40,
  "batch_size": 32,
  "test_size": 0.2,
  "random_state": 42,
  "nperseg": 128,
  "use_hampel": true,
  "learning_rate": 0.001,
  "optimizer": "AdamW",
  "weight_decay": 1e-4,
  "scheduler": {"type": "ReduceLROnPlateau", "factor": 0.5, "patience": 3},
  "early_stopping": {"patience": 5, "monitor": "val_loss"},
  "dropout": 0.3,
  "augmentation": {"noise_std": 0.01, "time_shift_pct": 0.1, "scale_min": 0.9, "scale_max": 1.1, "mixup_alpha": 0.2},
  "output_dir": "experiments/results",
  "run_name": "baseline_lstm_cnn"
}
